$ Heritage Engine TIRE02 synthetic MF6.2 compatibility dataset.
$ NOT measured Pirelli/Peugeot data. It reproduces the existing prototype-road
$ rear tuning as an explicit .tir parameter set so the import path is exercised.

[UNITS]
LENGTH = 'm'
FORCE = 'N'
ANGLE = 'rad'
MASS = 'kg'
TIME = 's'

[MODEL]
FITTYP = 62
LONGVL = 16.6666666667
$ TIRE05 low-speed structural damping controls.
DAMP_LSG = 1.0
VX_STBL = 1.0

[DIMENSION]
UNLOADED_RADIUS = 0.2979
WIDTH = 0.205
RIM_RADIUS = 0.2159
RIM_WIDTH = 0.1778
ASPECT_RATIO = 0.40

[OPERATING_CONDITIONS]
INFLPRES = 220000.0
NOMPRES = 220000.0

[INERTIA]
$ Synthetic development values; not measured historical Pirelli data.
MASS = 8.5
IXX = 0.24
IYY = 0.42
BELT_MASS = 6.0
BELT_IXX = 0.18
BELT_IYY = 0.33

[VERTICAL]
FNOMIN = 3600.0
VERTICAL_STIFFNESS = 220000.0
VERTICAL_DAMPING = 1800.0
$ TIRE04 synthetic effective-rolling-radius coefficients. These are engineering
$ development seeds, not measured parameters for the historical Pirelli tire.
BREFF = 8.386
DREFF = 0.25826
FREFF = 0.07394
Q_RE0 = 1.0
Q_V1 = 0.00076
Q_V2 = 0.0

[CONTACT_PATCH]
$ TIRE04 finite contact-length seed. Width is reconstructed independently from
$ normal load and inflation pressure until the SWIFT contact provider is built.
Q_RA1 = 0.67594
Q_RA2 = 0.73800
Q_RB1 = 1.04487
Q_RB2 = -1.19176
$ TIRE06 adaptive 2D road envelope. These are clean-room development seeds.
ELLIPS_SHIFT = 0.82
ELLIPS_LENGTH = 0.115
ELLIPS_HEIGHT = 0.055
ELLIPS_ORDER = 2.0
ELLIPS_MAX_STEP = 0.10
ELLIPS_NWIDTH = 3
ELLIPS_NLENGTH = 3
ENV_C1 = 1.0
ENV_C2 = 1.0

[STRUCTURAL]
$ TIRE06 SWIFT-like rigid-ring development seed. Translational modes plus
$ yaw/wind-up are active, but these numbers are NOT identified tire-rig data.
LONGITUDINAL_STIFFNESS = 800000.0
LATERAL_STIFFNESS = 650000.0
YAW_STIFFNESS = 4500.0
FREQ_LONG = 65.0
FREQ_LAT = 55.0
FREQ_YAW = 50.0
FREQ_WINDUP = 75.0
DAMP_LONG = 0.18
DAMP_LAT = 0.20
DAMP_YAW = 0.22
DAMP_WINDUP = 0.18
DAMP_RESIDUAL = 0.02
DAMP_VLOW = 0.10
Q_BVX = 0.0
Q_BVT = 0.0

